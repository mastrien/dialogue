{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dialogue",
  "version": "0.1.1",
  "identifier": "com.dialogue.simulator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dialogue",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMjE1NDFBQUZCNEVCREEKUldUYTY3U3ZHbFFoang5NzN3ZFp1TStoaEEzSVBxUWwxdm9KMTBFZS95Um8zOVpEeDZLOFBDejEK",
      "endpoints": [
        "https://github.com/mastrien/dialogue/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
